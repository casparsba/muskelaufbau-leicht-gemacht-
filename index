DOCTYPE html>

<html lang="de">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<meta name="theme-color" content="#101310">

<title>FitTrack – Muskelaufbau</title>

<style>

:root {

  --bg:#101310;--panel:#1a1e1a;--panel2:#222722;

  --green:#b7f568;--text:#f3f5f0;--muted:#a0a99e;

  --border:#303730;--red:#ff7777;

}

*{box-sizing:border-box}

body{margin:0;background:var(--bg);color:var(--text);

font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}

button,input,select{font:inherit}

button{cursor:pointer}

header{padding:24px 18px 15px;max-width:1000px;margin:auto}

.brand{font-size:12px;color:var(--green);letter-spacing:3px;font-weight:800}

h1{font-size:29px;line-height:1.2;margin:8px 0}

h2{font-size:20px;margin:0 0 15px}

h3{font-size:15px;margin:0 0 8px}

p,.muted{color:var(--muted)}

main{max-width:1000px;margin:auto;padding:0 14px 110px}

nav{display:flex;gap:7px;overflow-x:auto;padding:5px 0 17px}

nav button{white-space:nowrap;background:var(--panel);color:var(--muted);

border:1px solid var(--border);border-radius:12px;padding:11px 14px}

nav button.active{background:var(--green);color:#18200f;border-color:var(--green);font-weight:800}

.page{display:none}.page.active{display:block}

.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}

.card{background:var(--panel);border:1px solid var(--border);

border-radius:17px;padding:17px;margin-bottom:12px;min-width:0}

.stat{font-size:27px;font-weight:800;margin:8px 0 0;overflow-wrap:anywhere}

.stat small{font-size:13px;color:var(--muted);font-weight:500}

.green{color:var(--green)}

label{display:block;color:var(--muted);font-size:12px;margin:12px 0 5px}

input,select{width:100%;min-width:0;background:#111511;color:var(--text);

border:1px solid #394139;border-radius:10px;padding:12px;outline:none}

input:focus,select:focus{border-color:var(--green)}

button.primary{background:var(--green);color:#17200e;border:0;

padding:12px 16px;border-radius:11px;font-weight:800}

button.secondary{background:var(--panel2);color:var(--text);

border:1px solid var(--border);padding:10px 13px;border-radius:10px}

button.danger{color:var(--red);background:transparent;border:1px solid #633838;

padding:7px 10px;border-radius:9px}

form button{width:100%;margin-top:16px}

.row{display:flex;justify-content:space-between;align-items:center;gap:10px}

.entry{border-top:1px solid var(--border);padding:13px 0}

.entry:first-child{border-top:0}

.entry strong{display:block;overflow-wrap:anywhere}

.entry .details{font-size:13px;color:var(--muted);margin:3px 0 8px}

.progress{height:8px;background:#303730;border-radius:9px;overflow:hidden;margin:10px 0}

.progress span{height:100%;display:block;background:var(--green);border-radius:9px}

.section-title{margin:23px 0 12px}

.full{grid-column:1/-1}

.inline{display:flex;gap:9px;align-items:end}

.inline>div{flex:1;min-width:0}

.inline button{margin-bottom:0}

.empty{color:var(--muted);padding:16px 0}

footer{text-align:center;font-size:12px;color:var(--muted);padding:20px}

@media(min-width:650px){

 .grid{grid-template-columns:repeat(3,minmax(0,1fr))}

 header{padding-top:35px}

}

</style>

</head>

<body>

<header>

  <div class="brand">FITTRACK / DEIN FORTSCHRITT</div>

  <h1>Muskelaufbau leicht gemacht<span class="green">.</span></h1>

  <p id="today"></p>

</header>

<main>

<nav aria-label="Navigation">

 <button class="active" data-page="dashboard">Übersicht</button>

 <button data-page="training">Training</button>

 <button data-page="nutrition">Ernährung</button>

 <button data-page="activity">Aktivität</button>

 <button data-page="profile">Körperdaten</button>

 <button data-page="backup">Backup</button>

</nav>

<section class="page active" id="dashboard">

 <div class="grid">

  <div class="card"><div class="muted">Trainings heute</div><div class="stat" id="sTrain">0</div></div>

  <div class="card"><div class="muted">Kalorien heute</div><div class="stat" id="sCalories">0 <small>kcal</small></div></div>

  <div class="card"><div class="muted">Protein heute</div><div class="stat" id="sProtein">0 <small>g</small></div></div>

  <div class="card"><div class="muted">Schritte heute</div><div class="stat" id="sSteps">0</div></div>

  <div class="card"><div class="muted">Körpergewicht</div><div class="stat" id="sWeight">– <small>kg</small></div></div>

  <div class="card"><div class="muted">Körpergröße</div><div class="stat" id="sHeight">– <small>cm</small></div></div>

 </div>

 <h2 class="section-title">Deine Tagesziele</h2>

 <div class="card">

  <div class="row"><span>Kalorien</span><strong id="calLabel">0 / 2500 kcal</strong></div>

  <div class="progress"><span id="calBar"></span></div>

  <div class="row"><span>Protein</span><strong id="proteinLabel">0 / 150 g</strong></div>

  <div class="progress"><span id="proteinBar"></span></div>

  <div class="row"><span>Schritte</span><strong id="stepsLabel">0 / 8000</strong></div>

  <div class="progress"><span id="stepsBar"></span></div>

  <p class="muted">Deine Ziele kannst du unten in den Einstellungen ändern.</p>

 </div>

 <h2 class="section-title">Letzte Aktivitäten</h2>

 <div class="card" id="recent"></div>

</section>

<section class="page" id="training">

 <h2>Trainingstagebuch</h2>

 <div class="card">

  <form id="trainingForm">

   <label for="exercise">Übung</label>

   <input id="exercise" required maxlength="100" placeholder="z. B. Bankdrücken">

   <div class="grid">

    <div><label for="sets">Sätze</label><input id="sets" type="number" min="1" max="100" value="3" required></div>

    <div><label for="reps">Wiederholungen</label><input id="reps" type="number" min="1" max="1000" value="10" required></div>

    <div><label for="weight">Gewicht (kg)</label><input id="weight" type="number" min="0" max="2000" step="0.25" value="20" required></div>

   </div>

   <label for="trainDate">Datum</label><input id="trainDate" type="date" required>

   <button class="primary">Training speichern</button>

  </form>

 </div>

 <div class="row section-title"><h2>Deine Einträge</h2><span id="trainCount" class="muted"></span></div>

 <div class="card" id="trainingList"></div>

</section>

<section class="page" id="nutrition">

 <h2>Ernährungstagebuch</h2>

 <div class="grid">

  <div class="card"><div class="muted">Kalorien heute</div><div class="stat" id="nCalories">0 <small>kcal</small></div></div>

  <div class="card"><div class="muted">Protein heute</div><div class="stat" id="nProtein">0 <small>g</small></div></div>

 </div>

 <div class="card">

  <form id="mealForm">

   <label for="meal">Mahlzeit / Lebensmittel</label>

   <input id="meal" required maxlength="100" placeholder="z. B. Haferflocken mit Quark">

   <div class="grid">

    <div><label for="mealCalories">Kalorien (kcal)</label><input id="mealCalories" type="number" min="0" max="100000" required placeholder="450"></div>

    <div><label for="mealProtein">Protein (g)</label><input id="mealProtein" type="number" min="0" max="10000" step="0.1" required placeholder="35"></div>

   </div>

   <label for="mealDate">Datum</label><input id="mealDate" type="date" required>

   <button class="primary">Mahlzeit speichern</button>

  </form>

 </div>

 <h2 class="section-title">Deine Mahlzeiten</h2>

 <div class="card" id="mealList"></div>

</section>

<section class="page" id="activity">

 <h2>Aktivität & Schritte</h2>

 <div class="card">

  <div class="muted">Deine Schritte heute</div>

  <div class="stat green" id="activitySteps">0</div>

  <div class="progress"><span id="activityBar"></span></div>

  <form id="stepsForm">

   <label for="stepsInput">Heutige Schrittzahl</label>

   <input id="stepsInput" type="number" min="0" max="200000" required placeholder="z. B. 8500">

   <button class="primary">Schritte speichern</button>

  </form>

  <p>Trage die Zahl von deinem iPhone oder deiner Fitness-App manuell ein. Schritte werden nicht automatisch aus Apple Health ausgelesen.</p>

 </div>

 <div class="card">

  <h3>Deine Tagesziele</h3>

  <form id="goalsForm">

   <label for="goalCalories">Kalorienziel (kcal)</label><input id="goalCalories" type="number" min="1" max="100000" required>

   <label for="goalProtein">Proteinziel (g)</label><input id="goalProtein" type="number" min="1" max="10000" required>

   <label for="goalSteps">Schrittziel</label><input id="goalSteps" type="number" min="1" max="200000" required>

   <button class="primary">Ziele speichern</button>

  </form>

 </div>

</section>

<section class="page" id="profile">

 <h2>Körperdaten</h2>

 <div class="card">

  <form id="profileForm">

   <label for="bodyWeight">Aktuelles Körpergewicht (kg)</label>

   <input id="bodyWeight" type="number" min="1" max="1000" step="0.1" placeholder="z. B. 78.5">

   <label for="bodyHeight">Körpergröße (cm)</label>

   <input id="bodyHeight" type="number" min="30" max="300" step="0.5" placeholder="z. B. 180">

   <button class="primary">Körperdaten speichern</button>

  </form>

 </div>

 <div class="card">

  <h3>BMI als Orientierung</h3>

  <div class="stat" id="bmi">–</div>

  <p>Der BMI ist ein grober Richtwert und unterscheidet nicht zwischen Muskel- und Fettmasse.</p>

 </div>

</section>

<section class="page" id="backup">

 <h2>Deine Daten & Sicherheit</h2>

 <div class="card">

  <h3>Backup exportieren</h3>

  <p>Speichere eine JSON-Sicherung deiner Trainingseinträge, Mahlzeiten, Schritte, Ziele und Körperdaten.</p>

  <button class="primary" id="exportBtn">Backup exportieren</button>

 </div>

 <div class="card">

  <h3>Backup importieren</h3>

  <p>Eine vorhandene Sicherung wird eingelesen und ersetzt die aktuellen App-Daten.</p>

  <label for="importFile">JSON-Datei auswählen</label>

  <input id="importFile" type="file" accept=".json,application/json">

  <button class="primary" id="importBtn">Backup importieren</button>

 </div>

 <div class="card">

  <h3>Datenschutz</h3>

  <p>Diese App speichert Einträge im lokalen Speicher dieses Browsers. Sie übermittelt sie nicht an einen eigenen Server. Browserdaten können beim Löschen der Website-Daten verloren gehen. Exportiere deshalb regelmäßig ein Backup.</p>

  <button class="danger" id="clearBtn">Alle App-Daten löschen</button>

 </div>

</section>

<footer>FITTRACK · Deine Daten, dein Fortschritt.</footer>

</main>

<script>

"use strict";

const KEY = "fittrack_muskelaufbau_v1";

const $ = id => document.getElementById(id);

const today = () => {

  const d = new Date();

  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;

};

const fresh = () => ({

  training: [], meals: [], steps: {}, weight: "", height: "",

  goals: { calories: 2500, protein: 150, steps: 8000 }

});

let data = load();

function load() {

  try {

    const raw = localStorage.getItem(KEY);

    if (!raw) return fresh();

    const d = JSON.parse(raw);

    return {

      ...fresh(), ...d,

      training: Array.isArray(d.training) ? d.training : [],

      meals: Array.isArray(d.meals) ? d.meals : [],

      steps: d.steps && typeof d.steps === "object" ? d.steps : {},

      goals: { ...fresh().goals, ...(d.goals || {}) }

    };

  } catch {

    return fresh();

  }

}

function save() {

  try {

    localStorage.setItem(KEY, JSON.stringify(data));

    render();

  } catch {

    alert("Speichern nicht möglich. Prüfe den freien Speicherplatz deines Browsers.");

  }

}

function escapeHTML(v) {

  return String(v ?? "").replace(/[&<>"']/g, c => ({

    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"

  }[c]));

}

function number(id) { return Number($(id).value); }

function fmt(n) {

  return Number(n || 0).toLocaleString("de-DE", {maximumFractionDigits:1});

}

function dateText(d) {

  if (!d) return "";

  const parts = d.split("-");

  return parts.length === 3 ? `${parts[2]}.${parts[1]}.${parts[0]}` : d;

}

function sum(items, key) {

  return items.reduce((s, x) => s + Number(x[key] || 0), 0);

}

function todayMeals() { return data.meals.filter(x => x.date === today()); }

function todayTraining() { return data.training.filter(x => x.date === today()); }

function setBar(id, value, goal) {

  $(id).style.width = Math.min(100, Math.max(0, goal ? value / goal * 100 : 0)) + "%";

}

function empty(text) {

  return `<div class="empty">${escapeHTML(text)}</div>`;

}

function removeButton(type, id) {

  return `<button class="danger" data-delete="${type}" data-id="${escapeHTML(id)}">Löschen</button>`;

}

function render() {

  const meals = todayMeals();

  const trains = todayTraining();

  const calories = sum(meals, "calories");

  const protein = sum(meals, "protein");

  const steps = Number(data.steps[today()] || 0);

  const g = data.goals;

  $("sTrain").textContent = trains.length;

  $("sCalories").innerHTML = `${fmt(calories)} <small>kcal</small>`;

  $("sProtein").innerHTML = `${fmt(protein)} <small>g</small>`;

  $("sSteps").textContent = fmt(steps);

  $("sWeight").innerHTML = `${data.weight ? fmt(data.weight) : "–"} <small>kg</small>`;

  $("sHeight").innerHTML = `${data.height ? fmt(data.height) : "–"} <small>cm</small>`;

  $("calLabel").textContent = `${fmt(calories)} / ${fmt(g.calories)} kcal`;

  $("proteinLabel").textContent = `${fmt(protein)} / ${fmt(g.protein)} g`;

  $("stepsLabel").textContent = `${fmt(steps)} / ${fmt(g.steps)}`;

  setBar("calBar", calories, g.calories);

  setBar("proteinBar", protein, g.protein);

  setBar("stepsBar", steps, g.steps);

  $("nCalories").innerHTML = `${fmt(calories)} <small>kcal</small>`;

  $("nProtein").innerHTML = `${fmt(protein)} <small>g</small>`;

  $("activitySteps").textContent = fmt(steps);

  $("stepsInput").value = steps;

  setBar("activityBar", steps, g.steps);

  $("bodyWeight").value = data.weight || "";

  $("bodyHeight").value = data.height || "";

  $("goalCalories").value = g.calories;

  $("goalProtein").value = g.protein;

  $("goalSteps").value = g.steps;

  const bmi = data.weight && data.height

    ? Number(data.weight) / Math.pow(Number(data.height) / 100, 2) : 0;

  $("bmi").textContent = bmi ? fmt(bmi) : "–";

  $("trainCount").textContent = `${data.training.length} Einträge`;

  $("trainingList").innerHTML = data.training.length

    ? [...data.training].sort((a,b) => b.date.localeCompare(a.date)).map(x => `

      <div class="entry">

       <div class="row"><strong>${escapeHTML(x.exercise)}</strong>${removeButton("training",x.id)}</div>

       <div class="details">${dateText(x.date)} · ${fmt(x.sets)} Sätze · ${fmt(x.reps)} Wdh. · ${fmt(x.weight)} kg</div>

      </div>`).join("")

    : empty("Noch keine Trainingseinträge. Füge deine erste Übung hinzu.");

  $("mealList").innerHTML = data.meals.length

    ? [...data.meals].sort((a,b) => b.date.localeCompare(a.date)).map(x => `

      <div class="entry">

       <div class="row"><strong>${escapeHTML(x.name)}</strong>${removeButton("meal",x.id)}</div>

       <div class="details">${dateText(x.date)} · ${fmt(x.calories)} kcal · ${fmt(x.protein)} g Protein</div>

      </div>`).join("")

    : empty("Noch keine Mahlzeiten eingetragen.");

  const recent = [

    ...data.training.map(x => ({date:x.date, name:x.exercise, detail:`Training · ${x.sets} Sätze × ${x.reps} Wdh.`, id:x.id, type:"training"})),

    ...data.meals.map(x => ({date:x.date, name:x.name, detail:`Ernährung · ${x.calories} kcal`, id:x.id, type:"meal"}))

  ].sort((a,b) => b.date.localeCompare(a.date)).slice(0,5);

  $("recent").innerHTML = recent.length ? recent.map(x => `

    <div class="entry"><strong>${escapeHTML(x.name)}</strong>

    <div class="details">${dateText(x.date)} · ${escapeHTML(x.detail)}</div></div>

  `).join("") : empty("Hier erscheinen deine letzten Trainingseinheiten und Mahlzeiten.");

}

document.querySelectorAll("nav button").forEach(btn => {

  btn.addEventListener("click", () => {

    document.querySelectorAll("nav button").forEach(b => b.classList.toggle("active", b === btn));

    document.querySelectorAll(".page").forEach(p => p.classList.toggle("active", p.id === btn.dataset.page));

  });

});

$("trainingForm").addEventListener("submit", e => {

  e.preventDefault();

  data.training.push({

    id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random(),

    exercise: $("exercise").value.trim(), sets: number("sets"),

    reps: number("reps"), weight: number("weight"), date: $("trainDate").value

  });

  save();

  $("exercise").value = "";

});

$("mealForm").addEventListener("submit", e => {

  e.preventDefault();

  data.meals.push({

    id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random(),

    name: $("meal").value.trim(), calories: number("mealCalories"),

    protein: number("mealProtein"), date: $("mealDate").value

  });

  save();

  $("meal").value = "";

  $("mealCalories").value = "";

  $("mealProtein").value = "";

});

$("stepsForm").addEventListener("submit", e => {

  e.preventDefault();

  data.steps[today()] = number("stepsInput");

  save();

});

$("profileForm").addEventListener("submit", e => {

  e.preventDefault();

  data.weight = $("bodyWeight").value === "" ? "" : number("bodyWeight");

  data.height = $("bodyHeight").value === "" ? "" : number("bodyHeight");

  save();

  alert("Körperdaten gespeichert.");

});

$("goalsForm").addEventListener("submit", e => {

  e.preventDefault();

  data.goals = {

    calories: number("goalCalories"),

    protein: number("goalProtein"),

    steps: number("goalSteps")

  };

  save();

  alert("Tagesziele gespeichert.");

});

document.addEventListener("click", e => {

  const btn = e.target.closest("[data-delete]");

  if (!btn) return;

  const type = btn.dataset.delete;

  if (!confirm("Diesen Eintrag wirklich löschen?")) return;

  if (type === "training") data.training = data.training.filter(x => String(x.id) !== btn.dataset.id);

  if (type === "meal") data.meals = data.meals.filter(x => String(x.id) !== btn.dataset.id);

  save();

});

$("exportBtn").addEventListener("click", () => {

  const blob = new Blob([JSON.stringify(data, null, 2)], {type:"application/json"});

  const url = URL.createObjectURL(blob);

  const a = document.createElement("a");

  a.href = url;

  a.download = `fittrack-backup-${today()}.json`;

  document.body.appendChild(a);

  a.click();

  a.remove();

  setTimeout(() => URL.revokeObjectURL(url), 1000);

});

$("importBtn").addEventListener("click", async () => {

  const file = $("importFile").files[0];

  if (!file) return alert("Bitte zuerst eine JSON-Backup-Datei auswählen.");

  try {

    const imported = JSON.parse(await file.text());

    if (!imported || !Array.isArray(imported.training) || !Array.isArray(imported.meals)

        || typeof imported.steps !== "object" || !imported.goals) {

      throw new Error("Ungültiges Backupformat");

    }

    if (!confirm("Das Backup importieren? Die aktuellen App-Daten werden ersetzt.")) return;

    data = {

      ...fresh(), ...imported,

      training: imported.training,

      meals: imported.meals,

      steps: imported.steps,

      goals: {...fresh().goals, ...imported.goals}

    };

    save();

    alert("Backup erfolgreich importiert.");

  } catch {

    alert("Die Datei konnte nicht importiert werden. Bitte wähle ein gültiges FitTrack-Backup.");

  }

});

$("clearBtn").addEventListener("click", () => {

  if (!confirm("Wirklich alle Trainingseinträge, Mahlzeiten, Schritte und Körperdaten löschen? Exportiere vorher ein Backup, wenn du die Daten behalten möchtest.")) return;

  data = fresh();

  save();

  alert("Alle App-Daten wurden gelöscht.");

});

$("today").textContent = new Date().toLocaleDateString("de-DE", {

  weekday:"long", day:"numeric", month:"long", year:"numeric"

});

$("trainDate").value = today();

$("mealDate").value = today();